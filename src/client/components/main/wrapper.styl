
.error-wrapper
  background var(--main)
  height 100%
  position fixed
  overflow-y scroll

#container
  .xterm
    padding 10px
  .session-batch-active
    .xterm-screen
      &::before
        font-size 30vmin
        font-weight bold
        color var(--text)
        display flex
        justify-content center
        align-items center
        position absolute
        top 0
        left 0
        right 0
        bottom 0
        z-index -1
.aegis-agent-fab
  position absolute
  right 16px
  bottom 18px
  z-index 160
  width 34px
  height 34px
  border 1px solid var(--main-darker)
  background var(--main)
  color var(--text)
  display flex
  align-items center
  justify-content center
  cursor pointer
  box-shadow 0 2px 8px rgba(0, 0, 0, .18)
  &:hover
    color var(--success)
    border-color var(--success)
