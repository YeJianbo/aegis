.aegis-agent-panel
  height 100%
  width 100%
  min-width 0
  flex 1 1 0
  box-sizing border-box
  color var(--text)
  overflow-x hidden

.aegis-agent-toolbar
  width 100%
  min-width 0
  margin-bottom 12px

.aegis-agent-url
  color var(--text-light)
  font-size 12px

.aegis-agent-alert
  margin-bottom 12px

.aegis-agent-metrics
  width 100%
  display grid
  grid-template-columns repeat(3, minmax(0, 1fr))
  gap 8px
  margin-bottom 16px
  .ant-statistic
    border 1px solid var(--main-darker)
    padding 10px
    background var(--main-light)
  .ant-statistic-title
    font-size 12px
  .ant-statistic-content
    font-size 18px

.aegis-agent-section
  width 100%
  margin-bottom 18px
  h3
    font-size 13px
    font-weight 600
    margin 0 0 8px

.aegis-agent-section-title
  margin-bottom 8px
  h3
    margin 0

.aegis-agent-policy
  display grid
  gap 8px

.aegis-agent-policy-popover
  width 360px

.aegis-agent-policy-input
  font-family Maple Mono, monospace
  font-size 12px

.aegis-agent-list-item
  width 100%

.aegis-agent-command
  margin 6px 0
  font-family Maple Mono, monospace
  font-size 12px
  word-break break-all

.aegis-agent-muted
  color var(--text-light)
  font-size 12px

.aegis-agent-actions
  margin-top 8px

.aegis-agent-compact-item
  padding 8px 0

.aegis-agent-popover-title
  min-width 260px

.aegis-agent-history-popover
  width 360px
  max-height 420px
  overflow-y auto

.aegis-agent-compact-collapse
  width 100%
  margin-top 6px
  .ant-collapse-item
    border-bottom 1px solid var(--main-darker) !important
  .ant-collapse-header
    align-items center !important
    padding 8px 0 !important
  .ant-collapse-header-text
    flex 1
  .ant-collapse-expand-icon
    color var(--text-light)
  .ant-collapse-content-box
    padding 2px 0 8px !important

.aegis-agent-collapse-label
  display inline-flex
  align-items center
  gap 8px
  .ant-tag
    margin-inline-end 0

.aegis-agent-history-item
  padding 6px 0
  .aegis-agent-command
    margin 4px 0
